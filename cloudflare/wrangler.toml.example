name = "hololive-ocg-worker"
main = "worker.ts"
compatibility_date = "2024-11-27"

# D1 Database binding
[[d1_databases]]
binding = "DB"
database_name = ""
database_id = ""

# Environment variables
[env.production.vars]
CORS_ORIGIN = "https://your-domain.com"

[env.development.vars]
CORS_ORIGIN = "http://localhost:3000"
