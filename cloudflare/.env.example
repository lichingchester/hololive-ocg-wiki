# Cloudflare credentials for setup-fts.sh --remote
# Copy this file to .env and fill in your values.
# .env is gitignored — do NOT commit real credentials.

# Your Cloudflare account ID (Cloudflare dashboard → right sidebar)
CLOUDFLARE_ACCOUNT_ID=

# API token with "D1 Edit" permission
# Create at: Cloudflare dashboard → My Profile → API Tokens → Create Token
CLOUDFLARE_API_TOKEN=
